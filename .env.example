# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env real a Git.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---------------------------------------------------------------------------
# Base de datos (usadas por Django para conectarse a PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_NAME=trendy_import
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=postgres
DATABASE_PORT=5432

# ---------------------------------------------------------------------------
# PostgreSQL (usadas por el propio contenedor de postgres para inicializarse)
# Deben coincidir con DATABASE_NAME / DATABASE_USER / DATABASE_PASSWORD
# ---------------------------------------------------------------------------
POSTGRES_DB=trendy_import
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# CORS (orígenes permitidos para consumir la API desde el frontend)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_URL=/api

# ---------------------------------------------------------------------------
# Autenticación (Fase 3)
# ---------------------------------------------------------------------------
# Opcional: contraseña fija para el usuario "admin" que crea
# `manage.py seed_dev_data`. Solo para desarrollo. Si se deja vacío, el
# comando genera una contraseña aleatoria y la imprime una sola vez.
DJANGO_DEV_ADMIN_PASSWORD=
